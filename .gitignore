# Dependencies (re-created by `npm install`)
node_modules/

# Build output
dist/

# Test-rig output (screenshots, generated maps, the isolated profile) — regenerate, never
# commit. It normally lives in the OS temp dir; this covers a --out pointed in here anyway.
.rig/

# Portable app data (IndexedDB, caches, scenes) — must never be uploaded
evermist-data/

# Map media — large binaries live on disk, not in git
*.webm
*.mp4
*.mov
*.mkv

# Stray map images dropped into the project root
/*.png
/*.jpg
/*.jpeg

# Claude Code machine-local settings
.claude/settings.local.json

# Private slash commands (his own workflow; not for anyone who clones this)
.claude/commands/

# Private working files - the backlog quotes him by name; OneDrive syncs them, git must not
.claude/private/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store

# Fire look prototype (throwaway harness + recovered/downloaded assets)
tools/fire-proto/
