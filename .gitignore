# Dependencies (re-created by `npm install`)
node_modules/

# Build output
dist/

# yt-dlp, fetched per platform by `postinstall` (tools/fetch-ytdlp.js). A 17MB binary per
# platform must not enter a public repo; the tag it comes from is pinned in that script.
vendor/

# Test-rig output (screenshots, generated maps, the isolated profile) — regenerate, never
# commit. It normally lives in the OS temp dir; this covers a --out pointed in here anyway.
.rig/

# Portable app data (IndexedDB, caches, scenes) — must never be uploaded
evermist-data/

# Map media — large binaries live on disk, not in git
*.webm
*.mp4
*.mov
*.mkv

# Stray map images dropped into the project root
/*.png
/*.jpg
/*.jpeg

# Claude Code machine-local settings
.claude/settings.local.json

# /commit's per-run state: where a stopped run resumes, and the notes awaiting a yes
.claude/commit/run.json
.claude/commit/notes.txt

# Private working files: specs, design prototypes, personal fixtures, archived memory
.claude/private/

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store

# Fire look prototype (throwaway harness + recovered/downloaded assets)
tools/fire-proto/
