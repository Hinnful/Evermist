{
  "name": "evermist",
  "version": "2.11.0",
  "description": "D&D fog-of-war map viewer for TV display",
  "main": "main.js",
  "author": "Hinnful",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hinnful/Evermist.git"
  },
  "scripts": {
    "postinstall": "node tools/fetch-ytdlp.js",
    "test": "node --test",
    "test:mutation": "stryker run",
    "start": "electron .",
    "stress": "electron . --stress",
    "stress:control": "electron . --stress --stress-no-reveals",
    "memprobe": "electron . --memprobe",
    "memprobe:small": "electron . --memprobe --memprobe-small",
    "memprobe:no-flush": "electron . --memprobe --memprobe-no-flush",
    "memprobe:no-save": "electron . --memprobe --memprobe-no-save",
    "rig": "node tools/rig/run.js",
    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux"
  },
  "build": {
    "appId": "com.evermist.app",
    "productName": "Evermist",
    "icon": "build/icon.png",
    "artifactName": "${productName}.${ext}",
    "files": [
      "index.html",
      "splash.html",
    "stage.html",
      "lib/pixi.min.js",
      "lib/polygon-clipping.umd.js",
      "src/**/*.js",
      "src/css/**/*.css",
      "main.js",
      "preload.js",
      "!node_modules/pdfjs-dist/**",
      "node_modules/pdfjs-dist/package.json",
      "node_modules/pdfjs-dist/legacy/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs",
      "!node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "extraResources": [
      {
        "from": "vendor/yt-dlp",
        "to": "yt-dlp"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Hinnful",
        "repo": "Evermist"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^4.10.38",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.0",
    "pixi.js": "7.4.3",
    "polygon-clipping": "0.15.7"
  }
}
